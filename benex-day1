#!/bin/zsh
# ------------------------------------------------------------------------------
# benex-day1 — the new hire runs this once, in iTerm2, on their first day.
# Installed on every Benex Mac by the bootstrap (root.sh drops it in /usr/local/bin).
#
# It walks through the sign-ins that only the person can do, in order, and
# checks each one. Safe to re-run; the steps it can check are skipped, the ones it
# can only ask about (open this app, accept that invite) get asked again.
#
# Email first, always: the GitHub org invite and the 1Password invite land in the
# Benex mailbox, so nothing else can be signed in to until the employee can read
# it. (Duo is the one thing that has to be working BEFORE the mailbox, and it
# can't be sorted out from this Mac: Duo Mobile is activated on the phone ahead
# of laptop setup, from an activation link Dan issues out of the Duo Admin Panel.
# Directory sync creating the user is not activation.)
#
# It asks for the employee's @getbenex.com address up front and saves it to
# ~/.benex/work-email. Nothing here guesses an address from the Mac's account
# name: people name their own local account, so that guess is wrong.
# ------------------------------------------------------------------------------
set -u
ok()   { print -P "%F{green}✔%f $1"; }
todo() { print -P "%F{yellow}→%f $1"; }
hr()   { echo; print -P "%F{blue}── $1 ──%f"; }
# Failures the hire has to act on. Printed where they happen, and again at the end
# so a long run can't scroll the only copy off the screen.
typeset -a DAY1_PROBLEMS
problem() { DAY1_PROBLEMS+=("$1"); print -P "%F{red}✗%f $1"; }
pause(){ read -k1 -s "?   press any key when done… "; echo; }
# same idea as pause, but waits for Return — and reads the terminal directly, so
# a piped/wrapped run stops here instead of silently "confirming" every step.
wait4(){ read -r "?   $1 " </dev/tty || { echo; todo "benex-day1 has to be run in a terminal (iTerm2), not piped"; exit 1; }; }
# open an app, or fall back to the browser if that app isn't on this Mac
app_or_web(){ open -a "$1" 2>/dev/null || { todo "$1 isn't installed on this Mac — using $2 in Chrome instead"; open "$2" 2>/dev/null; }; }

[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# Everything below this line needs Homebrew — the GitHub CLI and the installs that
# were left for this run. Without it the bootstrap didn't finish, and walking
# someone through sign-ins that cannot work only wastes their morning.
if ! command -v brew >/dev/null 2>&1; then
  hr "Setup isn't finished on this Mac"
  todo "Homebrew isn't installed, so the bootstrap didn't complete — none of day 1 will work yet."
  echo "   Run this, wait for it to finish, then start benex-day1 again:"
  echo "     curl -fsSL https://benextechnologies.github.io/mac-bootstrap/bootstrap.sh | zsh"
  echo "   If it fails again, send ~/Library/Logs/benex-user-bootstrap.log to Dan on Teams."
  exit 1
fi

if [ ! -f "$HOME/.benex-bootstrapped" ]; then
  hr "App install has not finished"
  todo "This Mac is not marked set up yet (no ~/.benex-bootstrapped)."
  echo "   Log: ~/Library/Logs/benex-user-bootstrap.log"
  echo "   If that file is still growing, the install is running — wait for it, then run benex-day1 again."
  echo "   If it lists FAILED lines, retry:"
  echo "     curl -fsSL https://benextechnologies.github.io/mac-bootstrap/bootstrap.sh | zsh"
  echo "   Still failing? Send that log and /var/log/benex-bootstrap.log to Dan on Teams."
  echo "   You can continue, but Outlook, 1Password, or the dev tools may not be installed yet."
fi

HOST_NOW=$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || true)
case "$HOST_NOW" in
  mba-*|mbp-*|mini-*|studio-*|imac-*|mac-*)
    ok "This Mac is named $HOST_NOW"
    ;;
  *)
    problem "This Mac is named '${HOST_NOW:-unset}', not the Benex pattern such as mba-45w9."
    echo "   root.sh sets HostName, LocalHostName, and ComputerName to <device>-<last 4 of the serial>."
    echo "   device is mba, mbp, mini, studio, or imac, lowercase."
    echo "   Send /var/log/benex-bootstrap.log to Dan. Look for a line starting 'Hostname set' or 'WARNING: hostname'."
    ;;
esac

hr "Welcome to Benex, $(id -F). This takes about 15 minutes."

# ---------------------------------------------------------------- 0. Your address
# The Mac's account name is whatever you typed when you set the Mac up ("localname"),
# which is NOT your mailbox — so ask once, save it, and use it everywhere after.
EMAIL_FILE="$HOME/.benex/work-email"
mkdir -p "$HOME/.benex"
EMAIL=""
[ -f "$EMAIL_FILE" ] && EMAIL=$(tr -d ' \t\r\n' < "$EMAIL_FILE" 2>/dev/null || true)
valid_email(){ [[ "$1" == *@getbenex.com && -n "${1%@getbenex.com}" && "${1%@getbenex.com}" != *@* ]]; }
if valid_email "$EMAIL"; then
  ok "Your Benex address: $EMAIL   (saved earlier in $EMAIL_FILE)"
else
  hr "Your Benex email address"
  while ! valid_email "$EMAIL"; do
    wait4 "What is your Benex email address? (e.g. first.last@getbenex.com)"
    EMAIL="${REPLY:l}"          # lower-cased…
    EMAIL="${EMAIL//[[:space:]]/}"   # …and with any stray spaces taken out
    valid_email "$EMAIL" || todo "It has to be the address Dan set up for you, ending in @getbenex.com"
  done
  print -r -- "$EMAIL" > "$EMAIL_FILE" && chmod 600 "$EMAIL_FILE"
  ok "Saved — everything below uses $EMAIL"
fi

# Git commits and the SSH key: whatever ran before this could only guess, so fix
# both now that we know. (Both idempotent; re-running just re-states the same thing.)
if ! command -v git >/dev/null 2>&1; then
  problem "git is not installed, so commits have no Benex email yet. Re-run the bootstrap, then benex-day1."
else
  if git config --global user.email "$EMAIL"; then
    ok "git will sign your commits as $(git config --global user.name) <$EMAIL>"
  else
    problem "Could not save git user.email. Run: git config --global user.email $EMAIL"
  fi
  if [ -f "$HOME/.ssh/id_ed25519" ] && ! grep -q " $EMAIL$" "$HOME/.ssh/id_ed25519.pub" 2>/dev/null; then
    if ssh-keygen -q -c -P "" -C "$EMAIL" -f "$HOME/.ssh/id_ed25519"; then
      cp "$HOME/.ssh/id_ed25519.pub" "$HOME/Desktop/GitHub-SSH-key-paste-me.txt" 2>/dev/null || \
        problem "Could not copy the public key to the Desktop. It is still at ~/.ssh/id_ed25519.pub."
      ok "SSH key comment updated to $EMAIL"
    else
      problem "Could not set the SSH key comment to $EMAIL. The key still works; GitHub may label it with the Mac account name."
    fi
  fi
fi

# ---------------------------------------------------------------- 0b. Finish the installs
# A Mac provisioned by the package installs everything nobody has to authenticate
# for, and leaves the rest here — Microsoft 365's installer needs an admin
# password, and there is no one at the keyboard at first login. This is the
# interactive run, so finish them now. (Nothing to do on the one-liner path: it
# could answer the prompt itself, so this list is empty.)
DEFER_FILE="$HOME/.benex/deferred-installs"
if [ -s "$DEFER_FILE" ] && command -v brew >/dev/null 2>&1; then
  hr "Finishing the installs that need your password"
  todo "macOS asks for your Mac password here — Microsoft 365 is a big download, give it a few minutes"
  typeset -a STILL_PENDING
  while IFS= read -r pending; do
    [ -n "$pending" ] || continue
    if brew list --cask "$pending" >/dev/null 2>&1; then
      ok "$pending already installed"
    elif { [ "$pending" = "microsoft-office" ] && [ -d "/Applications/Microsoft Word.app" ]; } \
      || { [ "$pending" = "microsoft-teams" ] && [ -d "/Applications/Microsoft Teams.app" ]; }; then
      # Apple Business pushed it as a Managed App while we waited — nothing to do.
      ok "$pending already installed (Managed App)"
    elif brew install --cask "$pending"; then
      ok "Installed $pending"
    else
      problem "$pending did not install. Retry when you can type your Mac password: brew install --cask $pending"
      echo "   The brew error above is the one to screenshot. Then re-run benex-day1."
      STILL_PENDING+=("$pending")
    fi
  done < "$DEFER_FILE"
  if [ ${#STILL_PENDING[@]} -eq 0 ]; then
    rm -f "$DEFER_FILE"
  else
    printf '%s\n' "${STILL_PENDING[@]}" > "$DEFER_FILE"
  fi
fi

# The other kind of leftover: work the unattended run wouldn't touch because it
# needed a person. The status line is the one this script can simply finish — the
# bootstrap skips it if ~/.claude/settings.json won't parse, and by now the
# employee may well have fixed it. Idempotent: an existing statusLine is kept.
MANUAL_FILE="$HOME/.benex/deferred-manual"
if command -v node >/dev/null 2>&1 && command -v ccstatusline >/dev/null 2>&1; then
  mkdir -p "$HOME/.claude"
  if node -e '
    const fs = require("fs");
    const [p, cmd] = process.argv.slice(1);
    let s = {};
    if (fs.existsSync(p)) {
      const raw = fs.readFileSync(p, "utf8").trim();
      if (raw) s = JSON.parse(raw);      // still broken: throw, change nothing
    }
    if (!s.statusLine) {
      s.statusLine = { type: "command", command: cmd, padding: 0 };
      fs.writeFileSync(p, JSON.stringify(s, null, 2) + "\n");
    }
  ' "$HOME/.claude/settings.json" "$(command -v ccstatusline)" 2>/dev/null; then
    if [ -f "$MANUAL_FILE" ] && grep -q "Claude status line" "$MANUAL_FILE" 2>/dev/null; then
      grep -v "Claude status line" "$MANUAL_FILE" > "$MANUAL_FILE.tmp" 2>/dev/null
      mv "$MANUAL_FILE.tmp" "$MANUAL_FILE" 2>/dev/null || rm -f "$MANUAL_FILE.tmp"
      [ -s "$MANUAL_FILE" ] || rm -f "$MANUAL_FILE"
      ok "Claude Code status line configured"
    fi
  fi
fi
if [ -s "$MANUAL_FILE" ]; then
  hr "Left over from the automatic setup"
  while IFS= read -r leftover; do
    [ -n "$leftover" ] && todo "$leftover"
  done < "$MANUAL_FILE"
  wait4 "press Return when you've read that…"
fi

# ---------------------------------------------------------------- 1. Work email
# Everything below arrives as an invite in this mailbox, so it has to come first.
hr "Your Benex email"
todo "Sign in at outlook.office.com as $EMAIL — your Microsoft password, then approve the Duo push on your phone"
open "https://outlook.office.com" 2>/dev/null
echo "   Duo Mobile should already be active on your phone from the pre-arrival step: aka.ms/mysecurityinfo with the"
echo "   temporary access pass to set your password, plus the Duo activation link Dan sent you."
echo "   (Asked for a push but Duo Mobile has no Benex account? It can't be activated from this Mac — contact Dan"
echo "    from your phone for an activation link, then come back to this step.)"
wait4 "press Return once you can read your mailbox…"
ok "Mailbox open — your invites are in there"

# ---------------------------------------------------------------- 2. Accept the invites
hr "Accept your invites (they're in the mailbox you just opened)"
todo "GitHub — no GitHub account yet? Create one at https://github.com/signup using $EMAIL"
todo "GitHub — then accept the benextechnologies invite: the link in the email, or the page just opened"
open "https://github.com/orgs/benextechnologies/invitation" 2>/dev/null
wait4 "press Return once you're a member of benextechnologies…"
ok "GitHub account is in the Benex org"
todo "1Password — open the invite email and accept it (benex.1password.com), sign up with $EMAIL, and save your Secret Key somewhere safe"
open "https://benex.1password.com" 2>/dev/null
wait4 "press Return once your 1Password account exists…"
ok "1Password account created"

# ---------------------------------------------------------------- 3. GitHub CLI
hr "GitHub"
if ! command -v gh >/dev/null 2>&1; then
  todo "GitHub CLI isn't installed yet — installing it now (this can take a minute)"
  if ! brew install gh; then
    problem "GitHub CLI did not install. Run: brew install gh"
    echo "   Then re-run benex-day1. The GitHub sign-in needs gh."
  fi
fi
if ! command -v gh >/dev/null 2>&1; then
  problem "Skipping GitHub sign-in because gh is not on PATH."
else
  authed=0
  if gh auth status >/dev/null 2>&1; then
    ok "GitHub CLI already signed in"
    authed=1
  else
    todo "Sign in to GitHub. Choose: GitHub.com → SSH → upload key ~/.ssh/id_ed25519.pub → Login with a web browser"
    if gh auth login --hostname github.com --git-protocol ssh --web; then
      authed=1
    else
      problem "gh auth login did not finish. Run it again: gh auth login --hostname github.com --git-protocol ssh --web"
    fi
  fi
  if [ "$authed" -eq 1 ]; then
    if gh auth setup-git; then
      ok "git will use this GitHub login"
    else
      problem "gh auth setup-git failed. Git over HTTPS may ask for a password. Re-run: gh auth setup-git"
    fi
    key_ok=0
    if [ ! -f "$HOME/.ssh/id_ed25519.pub" ]; then
      problem "No SSH public key at ~/.ssh/id_ed25519.pub. user.sh creates it; see ~/Library/Logs/benex-user-bootstrap.log."
    elif gh ssh-key list 2>/dev/null | grep -q "$(awk '{print $2}' "$HOME/.ssh/id_ed25519.pub" | cut -c1-20)"; then
      ok "SSH key is on your GitHub account"
      key_ok=1
    elif gh ssh-key add "$HOME/.ssh/id_ed25519.pub" --title "$(hostname -s) (Benex)"; then
      ok "Uploaded SSH key to GitHub"
      key_ok=1
    else
      problem "Could not upload the SSH key. Open https://github.com/settings/keys and add ~/.ssh/id_ed25519.pub."
      echo "   A copy is on the Desktop as GitHub-SSH-key-paste-me.txt while the upload is still outstanding."
    fi
    if ssh -T git@github.com 2>&1 | grep -q "successfully authenticated"; then
      ok "ssh -T git@github.com works"
    else
      problem "ssh -T git@github.com did not authenticate. The key has to be on the GitHub account you just signed in to."
    fi
    [ "$key_ok" -eq 1 ] && rm -f "$HOME/Desktop/GitHub-SSH-key-paste-me.txt"
  fi
fi
echo "   (Only if Dan gave you a YubiKey: add it at https://github.com/settings/security → Security keys)"

# ---------------------------------------------------------------- 3b. Benex shell helpers (shipped with the bootstrap, not cloned)
hr "Benex shell helpers (claudel / clauded / claudew)"
HELPER=/usr/local/benex/shell/benex.zsh
if [ ! -s "$HELPER" ]; then
  problem "Shell helpers are missing ($HELPER)."
  echo "   They ship with the Benex bootstrap. A missing GitHub org invite is not the cause, and cloning a repo will not fix it."
  echo "   Re-run, then open a new terminal tab:"
  echo "     curl -fsSL https://benextechnologies.github.io/mac-bootstrap/bootstrap.sh | zsh"
  echo "   Still missing? Send /var/log/benex-bootstrap.log to Dan on Teams."
elif ! zsh -n "$HELPER"; then
  problem "Shell helpers file has a syntax error: $HELPER. Send that file to Dan."
else
  # The file defines the launchers only when `claude` is already on PATH, and
  # returns without defining them otherwise. That is not a broken install.
  if ! zsh -c 'source "$1"; (( ${+commands[claude]} ))' _ "$HELPER"; then
    ok "Helpers installed ($HELPER) — they load in a new tab once claude is on PATH"
    echo "   No GitHub account is needed for these. After Claude Code is installed, open a new terminal tab and try:  claudel"
  elif ! zsh -c 'source "$1" && (( $+functions[clauded] && $+functions[claudel] && $+functions[claudew] ))' _ "$HELPER"; then
    problem "Helpers file is present and claude is on PATH, but claudel, clauded, and claudew are not defined: $HELPER. Send that file to Dan."
  else
    ok "Helpers installed ($HELPER) — no GitHub account needed for these"
    echo "   Open a new terminal tab so your shell loads them, then try:  claudel"
  fi
  echo "   clauded, claudel, and claudew all run Claude Code with permission prompts turned off."
  echo "   claudel also keeps the Mac awake with the lid closed, and turns sleep back on when that command exits."
  echo "   claudew runs the session in an isolated git worktree."
fi

# ---------------------------------------------------------------- 4. 1Password
hr "1Password"
todo "Open 1Password (in your Dock), sign in with $EMAIL, then confirm the extension is pinned in Chrome"
open -a "1Password" 2>/dev/null; pause

# ---------------------------------------------------------------- 5. Microsoft apps
hr "Outlook and Teams"
todo "Sign in to the Outlook and Teams apps as $EMAIL — same password and Duo push as the webmail"
app_or_web "Microsoft Outlook" "https://outlook.office.com"
app_or_web "Microsoft Teams"   "https://teams.microsoft.com"
pause
echo "   (Only if Dan gave you a YubiKey: add it at https://aka.ms/mysecurityinfo → Add sign-in method → Security key)"

# ---------------------------------------------------------------- 6. Claude Code
hr "Claude Code — developers only"
# Benex doesn't run a Claude Team/Enterprise workspace, so there's no invite
# waiting: developers make their own account on their Benex address. Everyone
# else has nothing to do here.
echo "   Not writing software? This whole step is not for you — press Return to skip it."
todo "Developers: make a Claude account at https://claude.ai using $EMAIL — it signs you up with a code emailed to that mailbox"
open "https://claude.ai" 2>/dev/null
echo "   Then subscribe to Claude Max, on the COMPANY CARD — not your own card, and not the cheaper plan."
wait4 "press Return once you're signed in at claude.ai (or to skip this step)…"
if command -v claude >/dev/null; then
  todo "Developers: run  claude   → it will ask you to log in (use $EMAIL) → then type /exit"
  pause
  ok "Claude Code ready — try:  claudel"
else
  problem "claude is not on PATH. If the app install is still running, wait and re-run benex-day1. Otherwise see ~/Library/Logs/benex-user-bootstrap.log (Node LTS and Claude Code)."
fi

# ---------------------------------------------------------------- 7. Docker / Cursor
hr "Docker Desktop and Cursor"
todo "Docker: open it once and approve the helper prompt"
open -a "Docker" 2>/dev/null; pause
todo "Cursor: open it and sign in with $EMAIL"
open -a "Cursor" 2>/dev/null; pause

# ---------------------------------------------------------------- 8. Optional
hr "Only if Dan has given you access"
echo "   Vercel  https://vercel.com/login"
echo "   Render  https://dashboard.render.com   (turn on 2FA under Account Settings)"

hr "Done"
if [ ${#DAY1_PROBLEMS[@]} -gt 0 ]; then
  echo "   These still need a fix. Screenshot this list and send it to Dan on Teams if a retry doesn't clear it:"
  for item in "${DAY1_PROBLEMS[@]}"; do
    print -P "   %F{red}✗%f $item"
  done
  echo "   Logs: ~/Library/Logs/benex-user-bootstrap.log"
  echo "         /var/log/benex-bootstrap.log"
else
  echo "   Everything else was set up automatically."
fi
echo
